# EnvioTec — example variables. Copy to .env (ignored by Git) only for local
# overrides. Values here are NOT functional and must never be used as real
# secrets. Secrets are never set here: they come from Docker secrets
# (files in ./secrets, generated with `npm run secrets:dev`).

# --- Docker Compose (host) -------------------------------------------------
HTTPS_PORT=443
HTTP_PORT=80
APP_ORIGIN=https://localhost
LOG_LEVEL=info
# Fixed subnet of the edge network and IP of nginx (TRUST_PROXY uses it).
EDGE_SUBNET=172.31.10.0/24
NGINX_IP=172.31.10.10
# Development only (docker-compose.override.yml), bound to 127.0.0.1.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Directory with the secret files.
SECRETS_DIR=./secrets

# --- Backend (set in docker-compose.yml; listed for reference) -------------
# NODE_ENV=production                 development | test | production
# PORT=3000
# LOG_LEVEL=info                      fatal | error | warn | info | debug | trace | silent
# DATABASE_URL_FILE=/run/secrets/database_url       user app_runtime
# MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url   user app_owner (phase 2)
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# REDIS_URL_FILE=/run/secrets/redis_url_backend
# CSRF_SECRET_FILE=/run/secrets/csrf_secret          >= 32 random characters
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key   32 random bytes, base64
# TRUST_PROXY=172.31.10.10           IP or CIDR of the edge proxy, never a wildcard
# APP_ORIGIN=https://enviotec.example.invalid
# SESSION_IDLE_TIMEOUT_MIN=30
# SESSION_ABSOLUTE_TIMEOUT_MIN=480
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# RATE_LIMIT_LOGIN_PER_IP=20
# RATE_LIMIT_LOGIN_PER_ACCOUNT=5
# HTTPS_PROXY=http://egress-proxy:3128
# NO_PROXY=postgres,redis,localhost,127.0.0.1
# NODE_USE_ENV_PROXY=1               fetch() (system mail) goes through HTTPS_PROXY
# --- Authentication (phase 3) ----------------------------------------------
# LOCKOUT_LOCAL_THRESHOLD=5          failures before the first lock (then 1, 2, 4... minutes)
# LOCKOUT_LOCAL_MAX_MIN=60
# LOCKOUT_AD_THRESHOLD=2             1 or 2: always below AD's own limit of 3
# LOCKOUT_AD_MIN=15
# PASSWORD_RESET_TTL_MIN=30          15 to 30
# AD_ENABLED=false                   true requires every LDAP_* variable below
# LDAP_URL=ldaps://dc.example.invalid          LDAPS only
# LDAP_CA_CERT_FILE=/run/secrets/ldap_ca_cert  internal CA (PEM)
# LDAP_BIND_DN=CN=svc-enviotec,OU=Servicios,DC=example,DC=invalid   read-only service account
# LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
# LDAP_BASE_DN=DC=example,DC=invalid
# LDAP_ALLOWED_GROUP_DN=CN=EnvioTec-Usuarios,OU=Grupos,DC=example,DC=invalid
# LDAP_TIMEOUT_MS=5000
# MANDRILL_SYSTEM_API_KEY_FILE=/run/secrets/mandrill_system_api_key   system mail; without it, mail is disabled
# Worker only (ADR-024): campaign sending; without the key nothing is sent.
# MANDRILL_CAMPAIGNS_API_KEY_FILE=/run/secrets/mandrill_campaigns_api_key
# MANDRILL_API_URL=https://mandrillapp.com/api/1.0
# SENDING_BATCH_SIZE=100
# MAIL_FROM=no-reply@envios.example.invalid    required with the key
# MAIL_FROM_NAME=EnvioTec
