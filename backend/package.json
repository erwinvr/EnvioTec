{
  "name": "enviotec-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --test-timeout=300000 --experimental-test-coverage --test-coverage-include=\"src/core/**\" --test-coverage-include=\"src/modules/**\" --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/multipart": "10.1.6",
    "ajv": "8.20.0",
    "bullmq": "6.5.3",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "ldapts": "9.2.0",
    "mammoth": "1.13.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sanitize-html": "2.18.1",
    "uqr": "0.1.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
